<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ER2_BattlefieldCommander</AssemblyName>
    <RootNamespace>ER2SquadCommand</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>CS0618</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 排除非源码目录：research/docs/src/bin/obj 都不是编译输入，保持与其它 mod 扁平结构一致 -->
  <ItemGroup>
    <Compile Remove="research\**" />
    <Compile Remove="docs\**" />
    <Compile Remove="src\**" />
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
    <Compile Remove="deps\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="research\**" />
    <None Include="research\**" Exclude="research\obj\**;research\bin\**" />
    <None Remove="docs\**" />
    <None Include="docs\**" />
  </ItemGroup>

